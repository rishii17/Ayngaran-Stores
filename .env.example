NEXT_PUBLIC_SUPABASE_URL=https://uoddttvmpqkojdwofcxr.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key
API_PORT=4000

# Public releases use live sign-in and show no sample products.
# Enable only for isolated development/browser tests, then rebuild.
NEXT_PUBLIC_ENABLE_SAMPLE_MODE=false

# Optional user creation inside Settings. Server-only: never use NEXT_PUBLIC_ here.
# Create the first administrator in Supabase Auth, then copy its user UUID below.
AYNGARAN_ADMIN_USER_IDS=
# Hosting secret: Supabase secret key (or legacy service-role key), never a public client key.
SUPABASE_SECRET_KEY=
