{
  "name": "ayngaran-stores",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "check:env": "node --env-file-if-exists=.env.local scripts/check-env.mjs",
    "seed:generate": "node scripts/generate-seed.mjs",
    "verify": "npm run check:env && npm test && npm run build && npm run typecheck",
    "test:browser": "node tests/browser/release.mjs && node tests/browser/scanner.mjs && node tests/browser/purchase-calculator.mjs && node tests/browser/scanner-formats.mjs && node tests/browser/hardware-scanner.mjs",
    "audit:security": "npm audit --audit-level=moderate",
    "prebuild": "node --env-file-if-exists=.env.local scripts/check-env.mjs --allow-missing",
    "check:auth": "node --env-file-if-exists=.env.local scripts/check-auth.mjs"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource/noto-sans-tamil": "5.3.0",
    "@supabase/supabase-js": "2.117.3",
    "@zxing/browser": "0.2.1",
    "@zxing/library": "0.23.0",
    "concurrently": "10.0.6",
    "exceljs": "4.4.0",
    "express": "5.3.0",
    "express-rate-limit": "8.7.1",
    "helmet": "8.3.0",
    "lucide-react": "1.55.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "playwright-core": "1.64.0",
    "prettier": "3.9.10",
    "typescript": "7.0.2"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}
